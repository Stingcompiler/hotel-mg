{
  "color": {
    "bg-page": "#F6F7F9", "bg-surface": "#FFFFFF", "bg-surface-2": "#F1F3F6",
    "border": "#E3E6EB", "border-strong": "#C9CED6",
    "text-primary": "#1B2430", "text-secondary": "#5B6674", "text-disabled": "#9AA3AF",
    "primary": "#0F766E", "primary-hover": "#115E59", "primary-soft": "#CCFBF1", "primary-text-on": "#FFFFFF",
    "state": {
      "ready":       { "label": "جاهزة",        "solid": "#16A34A", "soft": "#DCFCE7", "text-on-soft": "#14532D" },
      "occupied":    { "label": "مشغولة",       "solid": "#2563EB", "soft": "#DBEAFE", "text-on-soft": "#1E3A8A" },
      "cleaning":    { "label": "تحتاج تنظيف",  "solid": "#D97706", "soft": "#FEF3C7", "text-on-soft": "#78350F" },
      "maintenance": { "label": "صيانة",        "solid": "#6B7280", "soft": "#E5E7EB", "text-on-soft": "#1F2937" },
      "overdue":     { "label": "متجاوزة",      "solid": "#DC2626", "soft": "#FEE2E2", "text-on-soft": "#7F1D1D" },
      "reserved-soon": { "label": "محجوزة قريبًا", "outline": "#7C3AED" }
    },
    "success": "#16A34A", "warning": "#D97706", "danger": "#DC2626", "info": "#2563EB",
    "owner-banner-bg": "#FFEDD5", "owner-banner-text": "#B45309",
    "chart-secondary": "#94A3B8"
  },
  "typography": {
    "family": "IBM Plex Sans Arabic", "fallback": "Noto Sans Arabic",
    "numeric": "tabular-nums",
    "page-title":      { "size": 20, "weight": 600, "lineHeight": 28 },
    "section-title":   { "size": 16, "weight": 600, "lineHeight": 24 },
    "body":            { "size": 14, "weight": 400, "lineHeight": 22 },
    "table-cell":      { "size": 14, "weight": 400, "lineHeight": 20 },
    "label":           { "size": 12, "weight": 500, "lineHeight": 16 },
    "headline-number": { "size": 28, "weight": 700, "lineHeight": 34 },
    "room-number":     { "size": 22, "weight": 700, "lineHeight": 28 }
  },
  "spacing": { "base": 4, "steps": [4, 8, 12, 16, 24, 32] },
  "radius": { "control": 6, "card": 8, "modal": 12 },
  "shadow": { "card": "none", "elevated": "0 8px 24px rgba(27,36,48,0.12)" },
  "focusRing": { "width": 2, "offset": 2, "color": "#0F766E" },
  "icon": { "set": "lucide", "control": 20, "inline": 16, "stroke": 1.75 },
  "size": { "tableRow": 40, "cardPadding": 16, "button": [36, 44], "topBar": 56, "sidebar": 240, "sidebarRail": 64, "drawer": 480, "roomCard": [220, 132] }
}
