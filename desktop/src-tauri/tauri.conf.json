{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sky Towers",
  "version": "1.0.1",
  "identifier": "sd.skytowers.hms",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sky Towers",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sky Towers",
    "shortDescription": "نظام إدارة فندق سكاي تاورز",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../dist-server/skytowers-server/": "server/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
